#!/usr/bin/env bash

# Synopsis:
# Test the track's exercises: every test of an exercise is run against its
# example/exemplar solution.
#
# Every exercise is a subproject of the build (see project/Exercises.scala), so all of
# them are tested in a single sbt session. The exercises are left untouched: the sources
# that are compiled - the example solution, and the tests with their `pending` markers
# blanked out - are assembled under target/.

# Arguments:
# $@: exercise slugs: only these exercises will be tested (optional)

# Examples:
# ./bin/test
# ./bin/test two-fer
# ./bin/test two-fer bob

set -eu -o pipefail

die() {
    echo "$*" >&2
    exit 1
}

command -v sbt > /dev/null ||
    die "sbt is required but not installed. See https://www.scala-sbt.org/download."

cd "$(dirname "$0")/.."

sbt_commands=()
if (( $# )); then
    for exercise_slug; do
        [ -d "exercises/concept/${exercise_slug}" ] || [ -d "exercises/practice/${exercise_slug}" ] ||
            die "No such exercise: ${exercise_slug}"
        sbt_commands+=( "${exercise_slug}/test" )
    done
else
    sbt_commands+=( "exercises/test" )
fi

exec sbt -batch "${sbt_commands[@]}"
