{#- Shared pieces every generated suite needs.

    Suites are written in the Scala 3 braceless syntax the track's .scalafmt.conf asks for,
    and laid out the way scalafmt would lay them out, so that formatting one changes nothing. -#}

{#- Imports, the generated-file notice, and the class declaration. -#}
{%- macro header(suite) -%}
import org.scalatest.funsuite.AnyFunSuite
import org.scalatest.matchers.should.Matchers

/** Generated from the canonical data in problem-specifications.
  *
  * Do not edit by hand: change .meta/template.j2 and run bin/generate-tests.
  */
class {{ suite }}Test extends AnyFunSuite with Matchers:
{%- endmacro -%}

{#- A case's name: the canonical group path, outermost first. -#}
{%- macro test_name(case) -%}
{{ case.descriptions | join(" - ") }}
{%- endmacro -%}

{#- `test("name"):`, opening a case's body. -#}
{%- macro test_open(case) -%}
{{ "  test(" ~ (test_name(case) | scala) ~ "):" }}
{%- endmacro -%}

{#- `subject should be(expected)` on one line while it fits in maxColumn (160),
    otherwise the expectation on its own line with a trailing comma, as scalafmt
    wraps it. Built as one string so that Jinja whitespace control cannot eat the
    indentation. -#}
{%- macro assert_be(subject, expected) -%}
{%- set one_line = "    " ~ subject ~ " should be(" ~ expected ~ ")" -%}
{%- if one_line | length <= 160 -%}
{{ one_line }}
{%- else -%}
{{ "    " ~ subject ~ " should be(\n      " ~ expected ~ ",\n    )" }}
{%- endif -%}
{%- endmacro -%}
