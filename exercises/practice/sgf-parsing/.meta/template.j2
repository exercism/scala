{%- import "macros.j2" as macros -%}
{#- A canonical tree as a Node; a node without children uses the default empty subForest. -#}
{%- macro properties(props) -%}
Map({% for key, values in props.items() %}{{ key | scala }} -> {{ values | scala }}{% if not loop.last %}, {% endif %}{% endfor %})
{%- endmacro -%}
{%- macro node(tree) -%}
{%- if tree.children -%}
Node({{ properties(tree.properties) }}, List({% for child in tree.children %}{{ node(child) }}{% if not loop.last %}, {% endif %}{% endfor %}))
{%- else -%}
Node({{ properties(tree.properties) }})
{%- endif -%}
{%- endmacro -%}
