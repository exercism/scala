{%- import "macros.j2" as macros -%}
{%- set PLANT = {"violets": "Plant.Violets", "clover": "Plant.Clover",
                 "radishes": "Plant.Radishes", "grass": "Plant.Grass"} -%}
{%- macro plants(expected) -%}
List({% for p in expected %}{{ PLANT[p] }}{% if not loop.last %}, {% endif %}{% endfor %})
{%- endmacro -%}
{{ macros.header("KindergartenGarden") }}
