{%- import "macros.j2" as macros -%}
{#- The expected matrix one row per line, so the test reads like the spiral. -#}
{{ macros.header("SpiralMatrix") }}
{% for case in cases %}

{{ macros.test_open(case) }}
{% if not loop.first %}
    pending
{% endif %}
{% if case.expected %}
    val expected = List(
{% for row in case.expected %}
{{ "      " ~ (row | scala) ~ "," }}
{% endfor %}
    )
{% else %}
    val expected = List()
{% endif %}
    SpiralMatrix.spiralMatrix({{ case.input.size }}) should be(expected)
{% endfor %}
